{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Code Review Schema",
  "description": "代码审查结构化数据校验规则（JSON唯一产出物）",
  "type": "object",
  "required": ["storyId", "issues", "summary"],
  "properties": {
    "storyId": { "type": "string", "minLength": 1 },
    "phase": { "type": "integer", "minimum": 3, "maximum": 3 },
    "reviewedAt": { "type": "string", "format": "date-time" },
    "fixRound": { "type": "integer", "minimum": 0 },
    "coverage": {
      "type": "object",
      "required": [
        "version",
        "repositories"
      ],
      "properties": {
        "version": {
          "const": 1
        },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "project",
              "root",
              "head",
              "base",
              "files"
            ],
            "properties": {
              "project": {
                "type": "string",
                "minLength": 1
              },
              "root": {
                "type": "string",
                "minLength": 1
              },
              "head": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "base": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "fingerprint",
                    "status"
                  ],
                  "properties": {
                    "path": {
                      "type": "string",
                      "minLength": 1
                    },
                    "fingerprint": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "reviewed",
                        "skipped"
                      ]
                    },
                    "evidence": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "beforeLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "indexLines": { "type": "integer", "minimum": 0 },
                    "afterLines": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rules": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "excluded": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "path",
                    "reason"
                  ],
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "file", "title", "description", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^(B|W|S)\\d+$" },
          "severity": { "type": "string", "enum": ["BLOCKER", "WARNING", "SUGGESTION"] },
          "file": { "type": "string", "minLength": 1, "description": "问题出现的位置（issue.file）。注意：跨仓 Story 中它只是「问题出现的位置」，修复点常在别处（例：跳转参数无人消费，问题报在跳出端，要改的是落地页）" },
          "project": { "type": "string", "description": "问题所属项目/仓库名（可选）。跨仓时用于表达仓归属，供 fix-loop 定位受影响文件到正确仓库" },
          "repoPath": { "type": "string", "description": "问题所属仓库的根路径或具体修复点路径（可选）。当修复点与 issue.file 不在同一仓库时声明" },
          "line": { "type": ["integer", "string", "null"] },
          "lineVersion": { "type": "string", "enum": ["worktree", "index", "base"] },
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" },
          "impact": { "type": "string", "description": "该问题影响的验收标准/功能范围（可含 AC-N 引用，供 Phase 4 交叉对账识别冲突）" },
          "reason": { "type": "string", "description": "问题根因分析（供修复回路定位）" },
          "status": { "type": "string", "enum": ["open", "fixed", "skipped"] },
          "notes": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "summary": {
      "type": "object",
      "required": ["blockerCount", "warningCount", "suggestionCount"],
      "properties": {
        "blockerCount": { "type": "integer", "minimum": 0 },
        "warningCount": { "type": "integer", "minimum": 0 },
        "suggestionCount": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
