{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Fix Request Schema",
  "description": "修复请求数据校验规则",
  "type": "object",
  "required": ["source", "sourcePhase", "round", "maxRounds", "issues", "affectedFiles"],
  "properties": {
    "source": { "type": "string", "enum": ["code-review", "acceptance-test"] },
    "sourcePhase": { "type": "integer", "minimum": 3, "maximum": 4 },
    "sourceFile": { "type": "string" },
    "round": { "type": "integer", "minimum": 1 },
    "maxRounds": { "type": "integer", "minimum": 1, "maximum": 5 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "severity", "description"],
        "properties": {
          "id": { "type": "string" },
          "severity": { "type": "string", "enum": ["BLOCKER", "WARNING"] },
          "file": { "type": "string" },
          "line": { "type": ["integer", "string"] },
          "description": { "type": "string", "minLength": 1 },
          "suggestion": { "type": "string" },
          "acId": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "affectedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "constraint": { "type": "string" }
  },
  "additionalProperties": true
}
